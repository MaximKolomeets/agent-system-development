VAULT_MCP_IMAGE=registry.example/scoped-vault-mcp@sha256:<64-hex-digest>
VAULT_MCP_CONTAINER_NAME=scoped-vault-mcp
VAULT_BACKEND_NETWORK_NAME=project_vault_backend
VAULT_STORAGE_EGRESS_NETWORK_NAME=project_storage_egress
VAULT_WEBDAV_ROOT_PATH=Company/Projects/example/vault
VAULT_YANDEX_USERNAME_SECRET_FILE=/restricted/secrets/yandex-username.txt
VAULT_YANDEX_PASSWORD_SECRET_FILE=/restricted/secrets/yandex-app-password.txt
VAULT_MCP_CLIENTS_SECRET_FILE=/restricted/secrets/vault-mcp-clients.json
VAULT_MCP_ALLOWED_HOSTS=vault-mcp,vault-mcp:8200,localhost,127.0.0.1,127.0.0.1:8200
