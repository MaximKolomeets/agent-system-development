{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Нормализованный снимок provider claim для sequence journal",
  "type": "object",
  "required": ["schema_version", "provider", "availability", "observed_at", "pull_requests"],
  "properties": {
    "schema_version": {"const": 1},
    "provider": {"type": "string", "minLength": 1},
    "availability": {"enum": ["available", "unavailable"]},
    "observed_at": {"type": "string", "minLength": 1},
    "pull_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "state", "head_sha", "reservation_claims"],
        "properties": {
          "id": {"type": ["string", "integer"]},
          "state": {"enum": ["open", "closed", "merged"]},
          "head_sha": {"type": "string", "minLength": 1},
          "reservation_claims": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["metadata_version", "sequence", "task_id", "reservation_id"],
              "properties": {
                "metadata_version": {"const": 1},
                "sequence": {"type": "string", "pattern": "^[0-9]{4}$"},
                "task_id": {"type": "string", "minLength": 1},
                "reservation_id": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
